void setPixel(
    std::vector<std::uint8_t>& pixels,
    int width,
    int x,
    int y,
    const std::uint8_t* colour)
{
    std::copy_n(
        colour,
        4,
        pixels.data() + static_cast<std::size_t>((y * width + x) * 4)
    );
}
